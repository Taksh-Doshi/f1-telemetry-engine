# Copy this file to .env and change the values. Never commit .env.

# --- Postgres (Docker) ---
POSTGRES_DB=f1_telemetry
POSTGRES_USER=f1_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=15432

# --- Valkey (cache, used later) ---
VALKEY_PORT=6379

# --- App connection strings (must match the values above) ---
DATABASE_URL=postgresql+psycopg://f1_user:change_me@localhost:15432/f1_telemetry
VALKEY_URL=redis://localhost:6379/0

# --- FastF1 ---
FASTF1_CACHE_DIR=cache


# Not needed, but useful if available.
F1_USERNAME=
F1_PASSWORD=
